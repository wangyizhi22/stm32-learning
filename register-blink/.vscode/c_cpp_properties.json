{
    "version": 4,
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Core/Include"
            ],
            "defines": [
                "STM32F103xB"
            ],
            "compilerPath": "${env:HOME}/stm32-tools/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m3",
                "-mthumb"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/Drivers"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
